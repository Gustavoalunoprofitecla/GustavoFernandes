#include <stdio.h>

int main(){

  printf("   Jogo de Palpites  \n\n Tente adivinhar o numero entre 1 e 50\n\n");
  
  int escolha, palpite;
  int numero_secreto = 29; 
  int jogador = 1;         

    int tentativas = 0;
    int max_tentativas = 10;

  while (palpite != numero_secreto && tentativas < max_tentativas) { 
      printf("\n\n[Tentativas restante: %d]", max_tentativas - tentativas);
    printf("\n\njogador %d digite o seu palpite: ", jogador);
    scanf("%d", &palpite);

      tentativas = tentativas + 1;

    if (palpite == numero_secreto) {
      printf("acertou, o jogador %d venceu!\n", jogador);
        }

    if (palpite < numero_secreto){
        printf("Mais para cima!");
    }
    else if (palpite > numero_secreto){
        printf("Mais para baixo!");
    }
    jogador = 3 - jogador;
          }
    printf("\n Fim de jogo! \n");
}
